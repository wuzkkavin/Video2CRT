[
  {
    "start": 0.0,
    "end": 25.0,
    "text": "Zither Harp"
  },
  {
    "start": 25.0,
    "end": 32.0,
    "text": "それ違う時の中で"
  },
  {
    "start": 32.0,
    "end": 39.0,
    "text": "あなたと巡り逢えた"
  },
  {
    "start": 39.0,
    "end": 47.0,
    "text": "不思議で願った奇跡が"
  },
  {
    "start": 47.0,
    "end": 54.0,
    "text": "こんなにもそばにあるなんて"
  },
  {
    "start": 55.0,
    "end": 62.0,
    "text": "会いたい想いのまま"
  },
  {
    "start": 62.0,
    "end": 69.0,
    "text": "会えない時間だけが"
  },
  {
    "start": 69.0,
    "end": 76.0,
    "text": "過ぎてく扉すり抜けて"
  },
  {
    "start": 76.0,
    "end": 80.0,
    "text": "また思い出して"
  },
  {
    "start": 80.0,
    "end": 89.0,
    "text": "あの人と笑い合うあなたを"
  },
  {
    "start": 89.0,
    "end": 95.0,
    "text": "愛しき人よ"
  },
  {
    "start": 95.0,
    "end": 102.0,
    "text": "悲しませないで泣き疲れて"
  },
  {
    "start": 102.0,
    "end": 109.0,
    "text": "眠る夜もあるから"
  },
  {
    "start": 109.0,
    "end": 115.0,
    "text": "過去を見ないで見つめて"
  },
  {
    "start": 115.0,
    "end": 120.0,
    "text": "私だけ"
  },
  {
    "start": 123.0,
    "end": 130.0,
    "text": "You're everything"
  },
  {
    "start": 130.0,
    "end": 138.0,
    "text": "あなたが思うように強く"
  },
  {
    "start": 138.0,
    "end": 145.0,
    "text": "優しい嘘ならいらない"
  },
  {
    "start": 145.0,
    "end": 152.0,
    "text": "欲しいのはあなた"
  },
  {
    "start": 153.0,
    "end": 160.0,
    "text": "Oh, me"
  },
  {
    "start": 164.0,
    "end": 171.0,
    "text": "どれくらいの時間を"
  },
  {
    "start": 171.0,
    "end": 178.0,
    "text": "永遠と呼べるだろう"
  },
  {
    "start": 178.0,
    "end": 185.0,
    "text": "果てしなく遠い未来なら"
  },
  {
    "start": 185.0,
    "end": 189.0,
    "text": "あなたと行きたい"
  },
  {
    "start": 189.0,
    "end": 192.0,
    "text": "あなたと望んでみたい"
  },
  {
    "start": 192.0,
    "end": 198.0,
    "text": "その日は"
  },
  {
    "start": 198.0,
    "end": 204.0,
    "text": "愛しい人よ"
  },
  {
    "start": 204.0,
    "end": 211.0,
    "text": "抱きしめていていつものように"
  },
  {
    "start": 211.0,
    "end": 218.0,
    "text": "優しい時の中で"
  },
  {
    "start": 218.0,
    "end": 225.0,
    "text": "この手握って見つめて"
  },
  {
    "start": 225.0,
    "end": 232.0,
    "text": "今だけを"
  },
  {
    "start": 232.0,
    "end": 239.0,
    "text": "You're everything"
  },
  {
    "start": 239.0,
    "end": 247.0,
    "text": "あなたが離れてる場所でも"
  },
  {
    "start": 247.0,
    "end": 254.0,
    "text": "会えばきっと許してしまう"
  },
  {
    "start": 254.0,
    "end": 261.0,
    "text": "どんな夜でも"
  },
  {
    "start": 261.0,
    "end": 268.0,
    "text": "You're everything"
  },
  {
    "start": 268.0,
    "end": 276.0,
    "text": "あなたの夢見るほど強く"
  },
  {
    "start": 276.0,
    "end": 280.0,
    "text": "愛せる力を"
  },
  {
    "start": 280.0,
    "end": 284.0,
    "text": "勇気に"
  },
  {
    "start": 284.0,
    "end": 290.0,
    "text": "今変えてゆこう"
  },
  {
    "start": 295.0,
    "end": 302.0,
    "text": "You're my everything"
  },
  {
